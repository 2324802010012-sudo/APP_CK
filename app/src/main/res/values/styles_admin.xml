<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="admin_primary">#2C7351</color>
    <color name="admin_heading">#182D22</color>
    <color name="admin_secondary">#687B6E</color>
    <color name="admin_background">#F6F8F5</color>
    <color name="admin_light">#EDF5EC</color>
    <color name="admin_border">#DFE9E1</color>
    <color name="admin_danger">#B5534A</color>
    <color name="admin_danger_background">#F6EAE8</color>

    <style name="AdminHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/admin_heading</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="AdminSection" parent="AdminHeading">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="AdminCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/admin_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="AdminLabel" parent="AdminCaption">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="AdminCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/ui_ct_action_bg</item>
    </style>
    <style name="AdminInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/ui_ct_action_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/admin_heading</item>
        <item name="android:textColorHint">@color/admin_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="AdminSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/admin_spinner_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="AdminButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/admin_button_text</item>
        <item name="backgroundTint">@color/admin_button_background</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="AdminButtonSecondary" parent="AdminButton">
        <item name="android:textColor">@color/admin_secondary_button_text</item>
        <item name="backgroundTint">@color/admin_light</item>
    </style>
    <style name="AdminButtonDanger" parent="AdminButton">
        <item name="android:textColor">@color/admin_danger</item>
        <item name="backgroundTint">@color/admin_danger_background</item>
    </style>
    <style name="AdminBack">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableStart">@drawable/ui_tq_back</item>
        <item name="android:drawableTint">@color/admin_primary</item>
        <item name="android:background">@drawable/ui_ct_audio_bg</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:contentDescription">Quay lại</item>
    </style>
    <style name="ThemeOverlay.Admin.Dialog" parent="ThemeOverlay.APP_CK.Dialog">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnSurface">@color/admin_heading</item>
        <item name="colorOnSurfaceVariant">@color/admin_secondary</item>
        <item name="android:textColorPrimary">@color/admin_heading</item>
        <item name="android:textColorSecondary">@color/admin_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AdminDialogPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/AdminDialogNegative</item>
        <item name="shapeAppearanceOverlay">@style/AdminDialogShape</item>
    </style>
    <style name="AdminDialogPositive" parent="Widget.APP_CK.Dialog.Positive">
        <item name="backgroundTint">@color/admin_primary</item>
    </style>
    <style name="AdminDialogNegative" parent="Widget.APP_CK.Dialog.Negative">
        <item name="android:textColor">@color/admin_primary</item>
        <item name="backgroundTint">@color/admin_light</item>
    </style>
    <style name="AdminDialogShape" parent="ShapeAppearance.APP_CK.Dialog">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ThemeOverlay.Admin.Screen" parent="">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/admin_primary</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@color/admin_heading</item>
        <item name="colorControlActivated">@color/admin_primary</item>
    </style>
</resources>
