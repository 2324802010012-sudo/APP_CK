<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:clipChildren="false"
        android:clipToPadding="false">
        <!-- THANH NEN: CAC MUC CAN DEU NHAU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/nen_thanh_dieu_huong"
            android:baselineAligned="false">
            <!-- KHAM PHA -->
            <LinearLayout
                android:id="@+id/navKhamPha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="9dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/bieu_tuong_kham_pha"
                    app:tint="#6F806F"
                    android:contentDescription="Khám phá"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Khám phá"
                    android:textSize="10sp"
                    android:textColor="#6F806F"/>
            </LinearLayout>
            <!-- BAN DO -->
            <LinearLayout
                android:id="@+id/navBanDo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/ui_ic_map"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Bản đồ"
                    android:textSize="10sp"
                    android:textColor="#6F806F" />

            </LinearLayout>
            <!-- CHUA CHO NUT TRANG CHU -->
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <!-- YEU THICH -->
            <LinearLayout
                android:id="@+id/navYeuThich"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="2dp" android:src="@drawable/ui_ic_heart" android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Yêu thích"
                    android:textSize="10sp"
                    android:textColor="#6F806F"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- CA NHAN -->
            <LinearLayout
                android:id="@+id/navCaNhan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="9dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/bieu_tuong_ca_nhan"
                    app:tint="#6F806F"
                    android:contentDescription="Cá nhân"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Cá nhân"
                    android:textSize="10sp"
                    android:textColor="#6F806F"/>
            </LinearLayout>

        </LinearLayout>

    <!-- TRANG CHU: NUT TRON NOI NHE, KHONG CO CHU -->
    <LinearLayout
        android:id="@+id/navTrangChu"
        android:layout_width="76dp"
        android:layout_height="96dp"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:paddingTop="22dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:contentDescription="Trang chủ">

        <!-- VONG VIEN BEN NGOAI -->
        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nen_trang_chu_vien"
            android:padding="4dp">

            <!-- HINH TRON XANH -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/nen_trang_chu_tron">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bieu_tuong_ngoi_nha"
                    app:tint="#FFFFFF"
                    android:importantForAccessibility="no" />

            </FrameLayout>
        </FrameLayout>

    </LinearLayout>


</FrameLayout>
