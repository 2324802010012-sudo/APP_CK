<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5ECE6"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/bdItemAnh"
            android:layout_width="108dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            android:background="@drawable/ui_kp_anh_bo_goc"
            android:clipToOutline="true"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bdItemTen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#20382A"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bdItemDiaChi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textSize="11sp"
                android:textColor="#819187"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bdItemKhoangCach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#286C49"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="28dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="›"
            android:textSize="27sp"
            android:textColor="#718778"
            android:importantForAccessibility="no" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
