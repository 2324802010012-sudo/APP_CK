<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#FFFFFF" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/qmkQuayLai" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="‹" android:textSize="32sp" android:textColor="#4F7C5A"
            android:clickable="true" android:focusable="true" android:contentDescription="Quay lại"/>
        <TextView android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" android:gravity="center" android:text="✦" android:textSize="35sp"
            android:textColor="#4F7C5A" android:background="@drawable/nen_dn_logo"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:gravity="center" android:text="Quên mật khẩu?"
            android:textSize="26sp" android:textStyle="bold" android:textColor="#24382D"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:text="Nhập mã khôi phục đã nhận khi đăng ký để tạo mật khẩu mới."
            android:textSize="14sp" android:textColor="#7C8B7D"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Tên đăng nhập" android:textStyle="bold" android:textColor="#24382D"/>
        <EditText android:id="@+id/qmkTenDangNhap" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:paddingHorizontal="16dp" android:hint="Nhập tên đăng nhập"
            android:inputType="text" android:singleLine="true" android:textColor="#24382D" android:textColorHint="#9AA59A"
            android:background="@drawable/nen_dn_input"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Mã khôi phục" android:textStyle="bold" android:textColor="#24382D"/>
        <EditText android:id="@+id/qmkMaKhoiPhuc" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:paddingHorizontal="16dp" android:hint="Nhập mã khôi phục"
            android:inputType="textVisiblePassword" android:singleLine="true" android:textColor="#24382D" android:textColorHint="#9AA59A"
            android:background="@drawable/nen_dn_input"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Mật khẩu mới" android:textStyle="bold" android:textColor="#24382D"/>
        <EditText android:id="@+id/qmkMatKhauMoi" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:paddingHorizontal="16dp" android:hint="Tối thiểu 8 ký tự"
            android:inputType="textPassword" android:singleLine="true" android:textColor="#24382D" android:textColorHint="#9AA59A"
            android:background="@drawable/nen_dn_input"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Xác nhận mật khẩu" android:textStyle="bold" android:textColor="#24382D"/>
        <EditText android:id="@+id/qmkXacNhan" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:paddingHorizontal="16dp" android:hint="Nhập lại mật khẩu mới"
            android:inputType="textPassword" android:singleLine="true" android:textColor="#24382D" android:textColorHint="#9AA59A"
            android:background="@drawable/nen_dn_input"/>
        <TextView android:id="@+id/qmkXacNhanDoi" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="28dp" android:gravity="center" android:text="Đặt lại mật khẩu  →"
            android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/nen_dn_button" android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:gravity="center" android:text="✦  Mỗi điểm đến là một câu chuyện"
            android:textSize="13sp" android:textColor="#7FA06E"/>
    </LinearLayout>
</ScrollView>
