<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tourBangAuto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/ui_home_gps_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/ui_home_voice_icon_bg">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ui_ic_route"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hướng dẫn theo vị trí"
                android:textColor="#20382A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tourCheDo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="GPS chưa bật"
                android:textColor="#2C7351"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/tourBatAuto"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="Bật hoặc dừng hướng dẫn GPS"
            android:gravity="center"
            android:showText="false"
            app:thumbIconTint="#FFFFFF"
            app:thumbTint="#FFFFFF"
            app:trackTint="@color/ui_gps_switch_track" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E5ECE6" />

    <TextView
        android:id="@+id/tourTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@drawable/ui_ct_audio_bg"
        android:textColor="#286C49"
        android:textSize="12sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

</LinearLayout>
