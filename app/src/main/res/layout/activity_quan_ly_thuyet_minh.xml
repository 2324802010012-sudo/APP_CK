<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:theme="@style/ThemeOverlay.Admin.Screen" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/admin_background"
    android:focusableInTouchMode="true">
    <include layout="@layout/view_admin_header" />
    <ScrollView android:id="@+id/tmScroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="16dp">
            <LinearLayout style="@style/AdminCard">
                <TextView style="@style/AdminSection" android:text="Chọn bài thuyết minh" />
                <TextView style="@style/AdminLabel" android:text="Địa điểm du lịch" android:labelFor="@id/tmDiaDiem" />
                <Spinner android:id="@+id/tmDiaDiem" style="@style/AdminSpinner"
                    android:contentDescription="Chọn địa điểm du lịch" />
                <TextView style="@style/AdminLabel" android:text="Bài thuyết minh" android:labelFor="@id/tmDiem" />
                <Spinner android:id="@+id/tmDiem" style="@style/AdminSpinner"
                    android:contentDescription="Chọn bài thuyết minh" />
            </LinearLayout>
            <LinearLayout style="@style/AdminCard">
                <TextView android:id="@+id/tmLoaiBai" style="@style/AdminCaption"
                    android:textColor="@color/admin_primary" />
                <TextView android:id="@+id/tmDoiTuong" style="@style/AdminSection"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout style="@style/AdminCard">
                <TextView style="@style/AdminSection" android:text="Nội dung thuyết minh" android:labelFor="@id/tmNoiDung" />
                <EditText android:id="@+id/tmNoiDung" style="@style/AdminInput"
                    android:layout_marginTop="12dp" android:singleLine="false"
                    android:gravity="top|start" android:minLines="8" android:maxLines="14"
                    android:scrollbars="vertical"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="flagNoEnterAction" android:hint="Nhập nội dung thuyết minh…" />
                <TextView android:id="@+id/tmDemKyTu" style="@style/AdminCaption"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout style="@style/AdminCard">
                <TextView style="@style/AdminSection" android:text="Nghe thử" />
                <TextView android:id="@+id/tmTrangThaiTts" style="@style/AdminCaption"
                    android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite"
                    android:text="Đang chuẩn bị giọng đọc…" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tmNgheThu"
                    style="@style/AdminButtonSecondary" android:layout_marginTop="12dp"
                    android:text="Nghe thử" android:enabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tmDung"
                    style="@style/AdminButtonSecondary" android:layout_marginTop="8dp"
                    android:text="Dừng" android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:background="@android:color/white"
        android:elevation="4dp">
        <TextView android:id="@+id/tmTrangThaiLuu" style="@style/AdminCaption"
            android:layout_marginBottom="8dp" android:text="Đã lưu" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/tmLuu"
            style="@style/AdminButton" android:text="Lưu nội dung" />
    </LinearLayout>
</LinearLayout>
