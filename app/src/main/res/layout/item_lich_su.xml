<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:padding="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ui_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- ANH DIA DIEM -->
    <ImageView
        android:id="@+id/lsAnhDiaDiem"
        android:layout_width="96dp"
        android:layout_height="104dp"
        android:background="@drawable/ui_card"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- THONG TIN LUOT NGHE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lsTenDiaDiem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#20382A"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/lsTenDiem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:textColor="#607467"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/lsCheDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2C7351" />

        <TextView
            android:id="@+id/lsThoiGian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="11sp"
            android:textColor="#87968B" />
    </LinearLayout>

    <!-- MENU THAO TAC -->
    <TextView
        android:id="@+id/lsXoaLuot"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="⋮"
        android:textSize="24sp"
        android:textColor="#788A7D"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Tùy chọn lượt nghe" />

</LinearLayout>
