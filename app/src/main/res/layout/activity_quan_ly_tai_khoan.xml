<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F5"
    android:orientation="vertical">

    <!-- THANH TIEU DE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/qltkQuayLai"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="‹"
            android:textColor="#245B43"
            android:textSize="32sp"
            android:contentDescription="Quay lại trang quản trị" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản lý tài khoản"
                android:textColor="#20382A"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ui_profile_hero"
            android:gravity="center"
            android:text="TK"
            android:textColor="#245B43"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- TIM KIEM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/ui_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#2C7351"
            android:textSize="26sp" />

        <EditText
            android:id="@+id/qltkTimKiem"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Tên đăng nhập, họ tên hoặc email"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textColor="#20382A"
            android:textColorHint="#96A298"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/qltkXoaTimKiem"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Xóa từ khóa tìm kiếm"
            android:text="×"
            android:textColor="#718277"
            android:textSize="24sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- TONG SO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DANH SÁCH TÀI KHOẢN"
            android:textColor="#2C7351"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qltkTongSo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 tài khoản"
            android:textColor="#718277"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- DANH SACH CUON -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/qltkDanhSach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/qltkTrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="Chưa có tài khoản phù hợp"
                android:textColor="#718277"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
