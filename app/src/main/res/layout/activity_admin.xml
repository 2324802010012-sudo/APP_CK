<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F5"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ui_ct_audio_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ui_ic_lock"
                    app:tint="#2C7351"
                    android:importantForAccessibility="no"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quản trị hệ thống"
                    android:textSize="20sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hành Trình Việt"
                    android:textSize="12sp"
                    android:textColor="#687B6E"/>

            </LinearLayout>

        </LinearLayout>

        <!-- TONG QUAN DU LIEU -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="@drawable/ui_profile_hero">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng quan dữ liệu"
                android:textSize="17sp"
                android:textColor="#182D22"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Thông tin đang lưu trong hệ thống"
                android:textSize="12sp"
                android:textColor="#687B6E"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- SO DIA DIEM -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="94dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/ui_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ui_ic_map"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/adminSoDiaDiem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textSize="21sp"
                        android:textColor="#182D22"
                        android:fontFamily="sans-serif-medium"
                        android:accessibilityLiveRegion="polite"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Địa điểm"
                        android:textSize="11sp"
                        android:textColor="#687B6E"/>

                </LinearLayout>

                <!-- SO DIEM THAM QUAN -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="94dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/ui_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ui_ic_route"
                        app:tint="#2C7351"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/adminSoDiem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textSize="21sp"
                        android:textColor="#182D22"
                        android:fontFamily="sans-serif-medium"
                        android:accessibilityLiveRegion="polite"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Điểm"
                        android:textSize="11sp"
                        android:textColor="#687B6E"/>

                </LinearLayout>

                <!-- SO TAI KHOAN -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="94dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/ui_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/bieu_tuong_ca_nhan"
                        app:tint="#2C7351"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/adminSoTaiKhoan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textSize="21sp"
                        android:textColor="#182D22"
                        android:fontFamily="sans-serif-medium"
                        android:accessibilityLiveRegion="polite"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tài khoản"
                        android:textSize="11sp"
                        android:textColor="#687B6E"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- QUAN LY NOI DUNG -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Quản lý nội dung"
            android:textSize="17sp"
            android:textColor="#182D22"
            android:fontFamily="sans-serif-medium"/>

        <!-- HANG CHUC NANG 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- DIA DIEM -->

            <LinearLayout
                android:id="@+id/adminDiaDiem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="150dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/ui_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mở quản lý địa điểm du lịch">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/ui_ct_audio_bg">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_ic_map"
                        android:importantForAccessibility="no"/>

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Địa điểm"
                    android:textSize="15sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Thông tin và hình ảnh"
                    android:textSize="12sp"
                    android:textColor="#687B6E"
                    android:maxLines="2"/>

            </LinearLayout>

            <!-- DIEM THAM QUAN -->

            <LinearLayout
                android:id="@+id/adminDiemThamQuan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:minHeight="150dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/ui_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mở quản lý điểm tham quan">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/ui_ct_audio_bg">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_ic_route"
                        app:tint="#2C7351"
                        android:importantForAccessibility="no"/>

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Điểm tham quan"
                    android:textSize="15sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Marker và sơ đồ"
                    android:textSize="12sp"
                    android:textColor="#687B6E"
                    android:maxLines="2"/>

            </LinearLayout>

        </LinearLayout>

        <!-- HANG CHUC NANG 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- THUYET MINH -->

            <LinearLayout
                android:id="@+id/adminThuyetMinh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="150dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/ui_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mở quản lý thuyết minh">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/ui_ct_audio_bg">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_ic_audio"
                        android:importantForAccessibility="no"/>

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Thuyết minh"
                    android:textSize="15sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Soạn và nghe thử"
                    android:textSize="12sp"
                    android:textColor="#687B6E"
                    android:maxLines="2"/>

            </LinearLayout>

            <!-- GPS AUTO -->

            <LinearLayout
                android:id="@+id/adminGpsAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:minHeight="150dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/ui_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mở cấu hình GPS AUTO">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/ui_ct_audio_bg">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_tq_gps"
                        android:importantForAccessibility="no"/>

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="GPS AUTO"
                    android:textSize="15sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Vị trí và bán kính"
                    android:textSize="12sp"
                    android:textColor="#687B6E"
                    android:maxLines="2"/>

            </LinearLayout>

        </LinearLayout>

        <!-- TAI KHOAN VA HE THONG -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Tài khoản và hệ thống"
            android:textSize="17sp"
            android:textColor="#182D22"
            android:fontFamily="sans-serif-medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="vertical"
            android:background="@drawable/ui_card">

            <TextView
                android:id="@+id/adminTaiKhoan"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/bieu_tuong_ca_nhan"
                android:drawableTint="#2C7351"
                android:drawablePadding="14dp"
                android:text="Quản lý tài khoản"
                android:textSize="15sp"
                android:textColor="#182D22"
                android:fontFamily="sans-serif-medium"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8EDE8"/>

            <TextView
                android:id="@+id/adminTrangChu"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/bieu_tuong_ngoi_nha"
                android:drawableTint="#2C7351"
                android:drawablePadding="14dp"
                android:text="Về trang chủ"
                android:textSize="15sp"
                android:textColor="#182D22"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8EDE8"/>

            <TextView
                android:id="@+id/adminDangXuat"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ui_ic_lock"
                android:drawableTint="#B5534A"
                android:drawablePadding="14dp"
                android:text="Đăng xuất"
                android:textSize="15sp"
                android:textColor="#B5534A"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
