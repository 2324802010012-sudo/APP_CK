<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- BAN DO CHINH -->
        <org.osmdroid.views.MapView
            android:id="@+id/banDoTuongTac"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- THANH TREN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:elevation="5dp"
            android:background="@drawable/ui_bd_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bản đồ khám phá"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#193B2B" />

                <TextView
                    android:id="@+id/banDoSoDiem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Địa điểm"
                    android:textSize="12sp"
                    android:textColor="#718678" />

            </LinearLayout>

            <!-- TIM KIEM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/ui_bd_input">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ui_ic_search"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/oTimKiemBanDo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Tìm địa điểm trên bản đồ..."
                    android:textColor="#20382A"
                    android:textColorHint="#87978C"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />

            </LinearLayout>

            <!-- CAC THAO TAC BAN DO -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nutTatCaBanDo"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="Tất cả"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/ui_bd_chip_active"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/nutGanToiBanDo"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="⌖  Gần tôi"
                        android:textSize="12sp"
                        android:textColor="#286C49"
                        android:background="@drawable/ui_bd_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/nutDanhSachBanDo"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="Danh sách"
                        android:textSize="12sp"
                        android:textColor="#286C49"
                        android:background="@drawable/ui_bd_chip"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- PHONG TO / THU NHO -->
        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="194dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:padding="2dp"
            android:elevation="5dp"
            android:background="@drawable/ui_bd_panel">

            <TextView
                android:id="@+id/nutPhongToBanDo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="+"
                android:textSize="27sp"
                android:textColor="#286C49"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Phóng to bản đồ" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5ECE6" />

            <TextView
                android:id="@+id/nutThuNhoBanDo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="−"
                android:textSize="27sp"
                android:textColor="#286C49"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Thu nhỏ bản đồ" />
        </LinearLayout>

        <!-- VI TRI HIEN TAI -->
        <TextView
            android:id="@+id/nutViTriCuaToi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="⌖"
            android:textSize="29sp"
            android:textColor="#286C49"
            android:background="@drawable/ui_bd_panel"
            android:elevation="5dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Vị trí của tôi" />

        <!-- NGUON BAN DO -->
        <TextView
            android:id="@+id/bdNguonBanDo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="16dp"
            android:padding="4dp"
            android:text="© OpenStreetMap contributors"
            android:textSize="10sp"
            android:textColor="#536B59"
            android:background="#EFFFFFFF" />

        <!-- THE DIA DIEM DUOC CHON -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/khungThongTinBanDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/anhDiaDiemBanDo"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/ui_kp_anh_bo_goc"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tenDiaDiemBanDo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#20382A"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/diaChiBanDo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="12sp"
                            android:textColor="#748579"
                            android:maxLines="3"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nutDongTheBanDo"
                        android:layout_width="40dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="×"
                        android:textSize="25sp"
                        android:textColor="#7B8D80"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Đóng thông tin địa điểm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/nutXemChiTietBanDo"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Xem chi tiết"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#286C49"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/nutChiDuongBanDo"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Chỉ đường"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textColor="#286C49"
                        android:backgroundTint="#E8F1E9"
                        android:enabled="false" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- DIEU HUONG DUNG CHUNG -->
    <include layout="@layout/view_thanh_dieu_huong_duoi" />

</LinearLayout>
