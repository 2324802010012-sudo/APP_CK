<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F1">
    <!-- BAN DO THUC TE -->
    <org.osmdroid.views.MapView
        android:id="@+id/banDoTuongTac"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- THANH PHIA TREN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="6dp"
        android:background="@drawable/ui_search_box">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/nutQuayLaiBanDo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="32sp"
                android:textColor="#254B33"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bản đồ du lịch"
                    android:textColor="#24382D"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Khám phá các di sản Việt Nam"
                    android:textColor="#708074"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 điểm"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4F7C5A"
                android:padding="6dp" />
        </LinearLayout>

        <!-- THANH TIM KIEM -->
        <EditText
            android:id="@+id/oTimKiemBanDo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:hint="⌕  Tìm địa điểm du lịch..."
            android:textSize="13sp"
            android:textColor="#24382D"
            android:textColorHint="#839187"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:background="#F1F4EE" />

        <!-- DANH SACH DIA DIEM CHON NHANH -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/nutChonDinhDocLap"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:text="Dinh Độc Lập"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4F7C5A" />

                <Button
                    android:id="@+id/nutChonBaoTang"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:text="Bảo tàng Chứng tích"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4F7C5A" />

                <Button
                    android:id="@+id/nutChonDaiNoiHue"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:text="Đại Nội Huế"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4F7C5A" />



                <Button
                    android:id="@+id/nutChonConDao"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:text="Nhà tù Côn Đảo"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4F7C5A" />

                <Button
                    android:id="@+id/nutChonVanMieu"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:text="Văn Miếu – Quốc Tử Giám"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4F7C5A" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- CAC NUT DIEU KHIEN BAN DO -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:background="@drawable/ui_search_box"
        android:elevation="5dp"
        android:padding="4dp">

        <TextView
            android:id="@+id/nutPhongToBanDo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#254B33"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Phóng to bản đồ" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8E1" />

        <TextView
            android:id="@+id/nutThuNhoBanDo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#254B33"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Thu nhỏ bản đồ" />

    </LinearLayout>

    <!-- NUT GPS -->
    <TextView
        android:id="@+id/nutViTriCuaToi"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="190dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="◎  Vị trí của tôi"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#254B33"
        android:background="@drawable/ui_search_box"
        android:elevation="5dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Xem vị trí hiện tại" />

    <!-- THE THONG TIN DIA DIEM -->
    <LinearLayout
        android:id="@+id/khungThongTinBanDo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="7dp"
        android:background="@drawable/ui_search_box">

        <ImageView
            android:id="@+id/anhDiaDiemBanDo"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/anh_dinh_doc_lap"
            android:contentDescription="Ảnh địa điểm du lịch" />

        <TextView
            android:id="@+id/tenDiaDiemBanDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn một địa điểm"
            android:textColor="#24382D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diaChiBanDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Chọn Marker hoặc địa điểm phía trên."
            android:textColor="#708074"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nutXemChiTietBanDo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Xem chi tiết"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4F7C5A"
                android:enabled="false" />

            <Button
                android:id="@+id/nutChiDuongBanDo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Chỉ đường"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#36718D"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- GHI NGUON BAN DO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="190dp"
        android:padding="3dp"
        android:text="© OpenStreetMap contributors"
        android:textSize="10sp"
        android:textColor="#24382D"
        android:background="#EFFFFFFF" />

</FrameLayout>
