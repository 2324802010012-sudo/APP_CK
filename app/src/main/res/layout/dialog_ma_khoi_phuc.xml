<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mật khẩu đã được cập nhật. Đây là mã khôi phục mới của bạn:"
        android:textColor="#607467"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- MA KHOI PHUC -->
    <TextView
        android:id="@+id/mkMa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="16dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="#20382A"
        android:textIsSelectable="true"
        android:background="@drawable/ui_profile_hero" />

    <!-- SAO CHEP -->
    <Button
        android:id="@+id/mkSaoChep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_marginTop="14dp"
        android:text="Sao chép mã"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="#2C7351"
        android:backgroundTint="#EAF1E8" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Hãy lưu mã ở nơi an toàn. Mã khôi phục cũ đã hết hiệu lực và mã mới chỉ được hiển thị trong phiên này."
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#A25248" />

</LinearLayout>
