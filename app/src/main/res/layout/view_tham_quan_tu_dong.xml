<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp"
    android:layout_marginBottom="16dp" android:background="@drawable/ui_card">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Hướng dẫn theo vị trí" android:textSize="18sp"
        android:textStyle="bold" android:textColor="#20382A" />
    <TextView android:id="@+id/autoCheDo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Chưa bật hướng dẫn" android:textStyle="bold" android:textColor="#2C7351" />
    <TextView android:id="@+id/autoTrangThai" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Tự nhận diện điểm đến gần bạn → hỏi Bắt đầu / Bỏ qua → chỉ phát khi bạn xác nhận."
        android:textSize="13sp" android:textColor="#607467" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/autoViTri" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Chưa lấy vị trí" android:textSize="12sp" android:textColor="#607467" />
    <TextView android:id="@+id/autoKhoangCach" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:visibility="gone" android:textSize="13sp" android:textColor="#20382A"
        android:lineSpacingExtra="3dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Chọn điểm đến để chạy demo" android:layout_marginTop="8dp"
        android:textSize="12sp" android:textColor="#607467" />
    <Spinner android:id="@+id/autoChonDiaDiemDemo" android:layout_width="match_parent"
        android:layout_height="48dp" android:contentDescription="Địa điểm mô phỏng" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/autoDemo" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:text="Chạy demo" android:textAllCaps="false" android:textSize="12sp"
            android:textColor="#FFFFFF" android:backgroundTint="#2C7351" />
        <Button android:id="@+id/autoGps" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:text="GPS thật" android:textAllCaps="false" android:textSize="12sp"
            android:textColor="#FFFFFF" android:backgroundTint="#2C7351" />
        <Button android:id="@+id/autoDung" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:text="Dừng" android:textAllCaps="false" android:textSize="12sp"
            android:textColor="#2C7351" android:backgroundTint="#EAF1E8" />
    </LinearLayout>
    <Button android:id="@+id/autoDemoDenGan" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="Demo: bước khoảng cách tiếp theo" android:textAllCaps="false"
        android:textSize="12sp" android:visibility="gone"
        android:backgroundTint="#EAF1E8" android:textColor="#2C7351" />
    <Button android:id="@+id/autoMoChiTiet" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="Mở chi tiết địa điểm" android:visibility="gone" android:textAllCaps="false" android:textSize="13sp"
        android:backgroundTint="#EAF1E8" android:textColor="#2C7351" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="GPS thật nhận diện cả 5 địa điểm khi trang chủ đang mở, bán kính 100 m. Demo mô phỏng 500 → 300 → 150 → 90 m, không dùng GPS thật. Luôn hỏi trước khi phát; các điểm bên trong chọn marker thủ công."
        android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#607467" />
</LinearLayout>
