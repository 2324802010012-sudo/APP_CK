<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/ui_home_gps_card">

    <LinearLayout
        android:id="@+id/autoTieuDeThuGon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:contentDescription="Trạng thái hướng dẫn theo vị trí">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:background="@drawable/ui_home_voice_icon_bg">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:src="@drawable/ui_home_navigation"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hướng dẫn theo vị trí"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#20382A" />

            <TextView
                android:id="@+id/autoCheDo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="GPS chưa bật"
                android:textSize="12sp"
                android:textColor="#2C7351"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoGps"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:contentDescription="Bật hoặc dừng hướng dẫn GPS"
            android:gravity="center"
            android:showText="false"
            app:thumbIconTint="#FFFFFF"
            app:thumbTint="#FFFFFF"
            app:trackTint="@color/ui_gps_switch_track" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/autoNoiDungMoRong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E5ECE6" />

        <TextView
            android:id="@+id/autoTrangThai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/ui_ct_audio_bg"
            android:text="Bật GPS để nhận diện địa điểm ở gần bạn."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#286C49"
            android:lineSpacingExtra="3dp"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/autoGanNhat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/ui_home_voice_card"
            android:textColor="#286C49"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/autoMoChiTiet"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="Mở chi tiết địa điểm"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#286C49"
            android:backgroundTint="#E8F1E9"
            app:cornerRadius="23dp" />
    </LinearLayout>

</LinearLayout>
