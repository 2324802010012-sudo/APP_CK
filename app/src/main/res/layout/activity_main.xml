<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:id="@+id/vungCuonTrangChu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Anh nen + tieu de + tim kiem -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/khungHeroTrangChu"
                android:layout_width="match_parent"
                android:layout_height="405dp"
                android:background="#14271D">

                <ImageView
                    android:id="@+id/anhNenTrangChu"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/anh_trang_chu"
                    android:scaleType="centerCrop"
                    android:contentDescription="Anh di san Viet Nam"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/ui_header_photo_overlay"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/hangMenuTrangChu"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✧  Hành Trình Việt"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nutTaiKhoan"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="☰"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Mo menu tai khoan" />
                </LinearLayout>

                <!-- O tim kiem nam hoan toan trong anh -->
                <LinearLayout
                    android:id="@+id/khungTimKiem"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="35dp"
                    android:layout_marginEnd="35dp"
                    android:layout_marginBottom="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/ui_search_box"
                    android:elevation="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ui_ic_search"
                        android:importantForAccessibility="no" />

                    <EditText
                        android:id="@+id/oTimKiem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp"
                        android:background="@android:color/transparent"
                        android:hint="Bạn muốn đến đâu?"
                        android:textColor="#20382A"
                        android:textColorHint="#88978C"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:inputType="text"
                        android:imeOptions="actionSearch" />

                    <FrameLayout
                        android:id="@+id/nutTimKiem"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/ui_search_action"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tim kiem dia diem">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ui_ic_arrow_right"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/noiDungHeroTrangChu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginEnd="26dp"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@id/khungTimKiem"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KHÁM PHÁ VIỆT NAM"
                        android:textColor="#E0EAE3"
                        android:textSize="11sp"
                        android:letterSpacing="0.14"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Chạm đến&#10;miền di sản."
                        android:fontFamily="serif"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="-3dp"
                        android:shadowColor="#88000000"
                        android:shadowRadius="4"
                        android:shadowDy="2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Khám phá địa điểm và lắng nghe những câu chuyện lịch sử."
                        android:textColor="#ECF3EE"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Noi dung trang chu -->
            <LinearLayout
                android:id="@+id/khungNoiDungBenDuoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                android:orientation="vertical"
                android:paddingTop="26dp"
                android:paddingBottom="32dp"
                android:background="@drawable/ui_home_body_top_round">

                <!-- TIEU DE DIA DIEM NOI BAT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ĐIỂM ĐẾN ĐÁNG KHÁM PHÁ"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:textColor="#6B8C78" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Điểm đến nổi bật"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="#172E22" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nutXemTatCa"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:paddingStart="10dp"
                        android:gravity="center"
                        android:text="Xem tất cả  ›"
                        android:textSize="12sp"
                        android:textColor="#287148"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- DIA DIEM TU SQLITE -->
                <HorizontalScrollView
                    android:id="@+id/cuonNoiBat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/danhSachNoiBat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="9dp"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- KHAM PHA BANG GIONG NOI -->
                <LinearLayout
                    android:id="@+id/khungTraiNghiem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_home_voice_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/ui_home_voice_icon_bg">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ui_home_headphones"
                                android:importantForAccessibility="no" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="TRẢI NGHIỆM DI SẢN"
                                android:textSize="10sp"
                                android:letterSpacing="0.08"
                                android:textStyle="bold"
                                android:textColor="#4A8A61" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Khám phá bằng giọng nói"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#20382A"
                                android:maxLines="2" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Chọn điểm trên bản đồ và lắng nghe câu chuyện di sản."
                                android:textSize="12sp"
                                android:textColor="#65796C"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutBatDauKhamPha"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="14dp"
                        android:minWidth="0dp"
                        android:text="Khám phá ngay  →"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#286C49"
                        app:cornerRadius="22dp" />

                </LinearLayout>

                <!-- HUONG DAN THEO VI TRI -->
                <FrameLayout
                    android:id="@+id/khungThuyetMinhTuDong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp" />

                <!-- TIEP TUC THAM QUAN -->
                <LinearLayout
                    android:id="@+id/khungTiepTucThamQuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tiếp tục tham quan"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#20382A" />

                    <LinearLayout
                        android:id="@+id/theTiepTucThamQuan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/ui_card"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/anhTiepTucThamQuan"
                            android:layout_width="140dp"
                            android:layout_height="112dp"
                            android:background="@drawable/ui_kp_anh_bo_goc"
                            android:clipToOutline="true"
                            android:scaleType="centerCrop"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tenTiepTucThamQuan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#20382A"
                                android:maxLines="2" />

                            <TextView
                                android:id="@+id/moTaTiepTucThamQuan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="12sp"
                                android:textColor="#6F8074"
                                android:maxLines="2" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="Mở lại địa điểm  →"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#2C7351" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- THANH DIEU HUONG DUOI -->
    <include layout="@layout/view_thanh_dieu_huong_duoi" />

</LinearLayout>
