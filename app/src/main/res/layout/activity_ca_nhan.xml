<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- THONG TIN TAI KHOAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/ui_profile_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/cnAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/ui_profile_avatar"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cnTen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#20382A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cnTenDangNhap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="#607467"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/cnTrangThai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#2C7351"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- THONG KE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cnSoYeuThich"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="86dp"
                    android:background="@drawable/ui_card"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="#2C7351"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/cnSoDiaDiem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:minHeight="86dp"
                    android:background="@drawable/ui_card"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="#2C7351"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- CHUA DANG NHAP -->
            <LinearLayout
                android:id="@+id/cnKhach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/ui_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lưu giữ những điểm đến yêu thích"
                    android:textColor="#20382A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Đăng nhập để quản lý bộ sưu tập và hồ sơ của bạn."
                    android:textColor="#718277"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/cnDangNhap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:minHeight="52dp"
                    android:backgroundTint="#2C7351"
                    android:text="Đăng nhập"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/cnDangKy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:backgroundTint="#EAF1E8"
                    android:text="Tạo tài khoản"
                    android:textAllCaps="false"
                    android:textColor="#2C7351" />
            </LinearLayout>

            <!-- DA DANG NHAP -->
            <LinearLayout
                android:id="@+id/cnDaDangNhap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="10dp"
                    android:text="TÀI KHOẢN CỦA BẠN"
                    android:textColor="#718277"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ui_card"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/cnSuaHoSo"
                        layout="@layout/item_ca_nhan_action" />

                    <include
                        android:id="@+id/cnYeuThich"
                        layout="@layout/item_ca_nhan_action" />

                    <include
                        android:id="@+id/cnLichSu"
                        layout="@layout/item_ca_nhan_action" />

                    <include
                        android:id="@+id/cnDoiMatKhau"
                        layout="@layout/item_ca_nhan_action" />
                </LinearLayout>

                <!-- CHI HIEN THI VOI ADMIN -->
                <LinearLayout
                    android:id="@+id/cnVungAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="QUẢN TRỊ HỆ THỐNG"
                        android:textColor="#2C7351"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/cnAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="54dp"
                        android:backgroundTint="#2C7351"
                        android:text="Quay lại trang quản trị"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/cnDangXuat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:minHeight="52dp"
                    android:backgroundTint="#F4EAE7"
                    android:text="Đăng xuất"
                    android:textAllCaps="false"
                    android:textColor="#9C493B" />
            </LinearLayout>

            <!-- THONG TIN UNG DUNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/ui_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/cnHuongDan"
                    layout="@layout/item_ca_nhan_action" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="APP_CK · Khám phá Việt Nam"
                android:textColor="#849387"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- GIU THANH DIEU HUONG CU -->
    <include layout="@layout/view_thanh_dieu_huong_duoi" />

</LinearLayout>
