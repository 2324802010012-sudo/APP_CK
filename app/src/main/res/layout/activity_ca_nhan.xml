<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8F5">

    <!-- NOI DUNG CO THE CUON -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp">

            <!-- TIEU DE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cá nhân"
                android:textColor="#20382A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

            <!-- THE HO SO -->
            <LinearLayout
                android:id="@+id/cnKhungHoSo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="116dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/ui_profile_hero">

                <TextView
                    android:id="@+id/cnAvatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/ui_profile_avatar"
                    android:gravity="center"
                    android:text="K"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cnTen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chào bạn!"
                        android:textColor="#20382A"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cnTenDangNhap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Khám phá Việt Nam"
                        android:textColor="#607467"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/cnTrangThai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Khách tham quan"
                        android:textColor="#2C7351"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <!-- THONG KE: CHI HIEN KHI DANG NHAP -->
            <LinearLayout
                android:id="@+id/cnThongKe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <!-- SO DIA DIEM YEU THICH -->
                <LinearLayout
                    android:id="@+id/cnThongKeYeuThich"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="100dp"
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:background="@drawable/ui_card"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/cnSoYeuThich"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textColor="#2C7351"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ui_ic_heart"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Địa điểm đã lưu"
                        android:textSize="12sp"
                        android:textColor="#607467" />
                </LinearLayout>

                <!-- SO LUOT NGHE -->
                <LinearLayout
                    android:id="@+id/cnThongKeLichSu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:minHeight="100dp"
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:background="@drawable/ui_card"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/cnSoLichSu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textColor="#2C7351"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ui_ic_history"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Lượt đã nghe"
                        android:textSize="12sp"
                        android:textColor="#607467" />
                </LinearLayout>
            </LinearLayout>

            <!-- GIAO DIEN KHACH -->
            <LinearLayout
                android:id="@+id/cnKhach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/ui_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lưu lại hành trình của bạn"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#20382A" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Đăng nhập để lưu địa điểm yêu thích và xem lại lịch sử thuyết minh."
                    android:textSize="13sp"
                    android:textColor="#718277"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/cnDangNhap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Đăng nhập"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C7351" />

                <Button
                    android:id="@+id/cnDangKy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Tạo tài khoản"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="#2C7351"
                    android:backgroundTint="#EAF1E8" />
            </LinearLayout>

            <!-- CHUC NANG KHI DA DANG NHAP -->
            <LinearLayout
                android:id="@+id/cnDaDangNhap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="TÀI KHOẢN CỦA BẠN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#718277" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/ui_card">

                    <include
                        android:id="@+id/cnSuaHoSo"
                        layout="@layout/item_ca_nhan_action" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:layout_marginEnd="16dp"
                        android:background="#EDF1ED" />

                    <include
                        android:id="@+id/cnLichSu"
                        layout="@layout/item_ca_nhan_action" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:layout_marginEnd="16dp"
                        android:background="#EDF1ED" />

                    <include
                        android:id="@+id/cnDoiMatKhau"
                        layout="@layout/item_ca_nhan_action" />

                </LinearLayout>

                <!-- CHI DANH CHO ADMIN -->
                <LinearLayout
                    android:id="@+id/cnVungAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="QUẢN TRỊ HỆ THỐNG"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#718277" />

                    <Button
                        android:id="@+id/cnAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:text="Mở trang quản trị"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2C7351" />
                </LinearLayout>
            </LinearLayout>

            <!-- THONG TIN UNG DUNG -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="ỨNG DỤNG"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#718277" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ui_card">

                <include
                    android:id="@+id/cnHuongDan"
                    layout="@layout/item_ca_nhan_action" />
            </LinearLayout>

            <!-- DANG XUAT -->
            <TextView
                android:id="@+id/cnDangXuat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="14dp"
                android:padding="12dp"
                android:gravity="center"
                android:text="Đăng xuất"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#A25248"
                android:background="@drawable/ui_card"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- THONG TIN CUOI TRANG -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Vọng Việt · Khám phá Việt Nam"
                android:textSize="12sp"
                android:textColor="#8B9A8E" />

        </LinearLayout>
    </ScrollView>

    <!-- GIU NGUYEN THANH DIEU HUONG HIEN TAI -->
    <include layout="@layout/view_thanh_dieu_huong_duoi" />

</LinearLayout>
