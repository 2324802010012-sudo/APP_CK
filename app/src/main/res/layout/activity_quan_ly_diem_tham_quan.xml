<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8F5"
    android:focusableInTouchMode="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/dtQuayLai"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#2C7351"
            android:background="@drawable/ui_ct_audio_bg"
            android:contentDescription="Quay lại"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dtTieuDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Điểm tham quan"
                android:textSize="19sp"
                android:textColor="#182D22"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Quản lý nội dung và sơ đồ"
                android:textSize="12sp"
                android:textColor="#687B6E"/>
        </LinearLayout>
    </LinearLayout>

    <!-- DANH SACH: ScrollView bao gom toan bo trang -->
    <ScrollView
        android:id="@+id/dtCuonDanhSach"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dtKhungDanhSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Địa điểm du lịch"
                    android:textColor="#182D22"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <Button
                    android:id="@+id/dtQuanLySoDo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Quản lý sơ đồ"
                    android:textAllCaps="false"
                    android:textColor="#2C7351"
                    android:backgroundTint="#E8F2E6"/>
            </LinearLayout>

            <Spinner
                android:id="@+id/dtChonDiaDiem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/ui_ct_action_bg"/>

            <!-- TIM KIEM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:background="@drawable/ui_ct_action_bg">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ui_ic_search"
                    android:importantForAccessibility="no"/>

                <EditText
                    android:id="@+id/dtTimKiem"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:hint="Tìm tên, mã điểm, tầng..."
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:textColor="#182D22"
                    android:textColorHint="#687B6E"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/dtXoaTim"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="×"
                    android:textSize="24sp"
                    android:textColor="#687B6E"
                    android:contentDescription="Xóa tìm kiếm"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- THEM MOI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dtSoLuong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Danh sách điểm"
                    android:textColor="#2C7351"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <Button
                    android:id="@+id/dtThemMoi"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="+ Thêm điểm"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C7351"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dtDanhSach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <!-- MAN HINH BIEU MAU -->
    <LinearLayout
        android:id="@+id/dtManBieuMau"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/dtKhungBieuMau"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/dtTieuDeBieuMau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Thêm điểm tham quan"
                    android:textColor="#182D22"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/dtGhiChu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="12dp"
                    android:text="Nhập thông tin điểm tham quan."
                    android:textColor="#687B6E"
                    android:textSize="12sp"/>

                <!-- NHOM 1: THONG TIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông tin cơ bản"
                        android:textColor="#182D22"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        style="@style/DDLabel"
                        android:text="Tên điểm tham quan *"/>

                    <EditText
                        android:id="@+id/dtTen"
                        style="@style/DDInput"
                        android:hint="Nhập tên điểm tham quan"
                        android:inputType="textCapSentences"/>

                    <TextView
                        style="@style/DDLabel"
                        android:text="Tầng hoặc khu vực"/>

                    <EditText
                        android:id="@+id/dtTang"
                        style="@style/DDInput"
                        android:hint="Mã tầng hoặc khu vực"
                        android:inputType="numberSigned"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/dtThuTu"
                            style="@style/DDInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="Thứ tự"
                            android:inputType="numberSigned"/>

                        <EditText
                            android:id="@+id/dtSoHienThi"
                            style="@style/DDInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="Số marker"
                            android:inputType="numberSigned"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- NHOM 2: NOI DUNG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nội dung tham quan"
                        android:textColor="#182D22"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        style="@style/DDLabel"
                        android:text="Giới thiệu ngắn"/>

                    <EditText
                        android:id="@+id/dtMoTa"
                        style="@style/DDInput"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:gravity="top|start"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:hint="Mô tả điểm tham quan..."
                        android:inputType="textMultiLine|textCapSentences"
                        android:singleLine="false"
                        android:minLines="3"
                        android:maxLines="6"/>

                    <TextView
                        style="@style/DDLabel"
                        android:text="Bài thuyết minh"/>

                    <EditText
                        android:id="@+id/dtThuyetMinh"
                        style="@style/DDInput"
                        android:layout_height="wrap_content"
                        android:minHeight="128dp"
                        android:gravity="top|start"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:hint="Nội dung thuyết minh bằng giọng nói..."
                        android:inputType="textMultiLine|textCapSentences"
                        android:singleLine="false"
                        android:minLines="4"
                        android:maxLines="10"/>
                </LinearLayout>

                <!-- NHOM 3: ANH RIENG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hình ảnh điểm tham quan"
                        android:textColor="#182D22"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ảnh riêng của điểm, không phải sơ đồ."
                        android:textColor="#687B6E"
                        android:textSize="12sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/dtAnhDiemXemTruoc"
                            android:layout_width="106dp"
                            android:layout_height="106dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:background="@drawable/ui_ct_thumb"
                            android:scaleType="centerInside"
                            android:clipToOutline="true"
                            android:contentDescription="Ảnh điểm tham quan"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/dtChonAnhDiem"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="Chọn ảnh"
                                android:textAllCaps="false"
                                android:textColor="#2C7351"
                                android:backgroundTint="#E8F2E6"/>

                            <Button
                                android:id="@+id/dtBoAnhDiem"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:text="Bỏ ảnh"
                                android:textAllCaps="false"
                                android:textColor="#B5534A"
                                android:backgroundTint="#F6EAE8"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dtMoAnhNangCao"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:text="Ảnh có sẵn trong dự án  ▾"
                        android:textColor="#2C7351"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <LinearLayout
                        android:id="@+id/dtAnhNangCao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/dtTenAnh"
                            style="@style/DDInput"
                            android:hint="Tên ảnh trong drawable"
                            android:inputType="text"
                            android:singleLine="true"/>

                        <Button
                            android:id="@+id/dtXemAnhDrawable"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:text="Xem trước ảnh drawable"
                            android:textAllCaps="false"
                            android:textColor="#2C7351"
                            android:backgroundTint="#E8F2E6"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- NHOM 4: NGUON -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nguồn tham khảo"
                        android:textColor="#182D22"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        style="@style/DDLabel"
                        android:text="Tên nguồn"/>

                    <EditText
                        android:id="@+id/dtNguonTenDiem"
                        style="@style/DDInput"
                        android:hint="Tên nguồn thông tin"
                        android:inputType="textCapSentences"/>

                    <TextView
                        style="@style/DDLabel"
                        android:text="Đường dẫn nguồn"/>

                    <EditText
                        android:id="@+id/dtNguonUrlDiem"
                        style="@style/DDInput"
                        android:hint="https://..."
                        android:inputType="textUri"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- NHOM 5: MARKER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vị trí marker trên sơ đồ"
                        android:textColor="#182D22"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="X/Y từ 0 đến 1, không phải tọa độ GPS."
                        android:textColor="#687B6E"
                        android:textSize="12sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/dtX"
                            style="@style/DDInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="X (0–1)"
                            android:inputType="numberDecimal"/>

                        <EditText
                            android:id="@+id/dtY"
                            style="@style/DDInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="Y (0–1)"
                            android:inputType="numberDecimal"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/dtChonMarker"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Chọn marker trên sơ đồ"
                        android:textAllCaps="false"
                        android:textColor="#2C7351"
                        android:backgroundTint="#E8F2E6"/>
                </LinearLayout>

                <Button
                    android:id="@+id/dtXoa"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Xóa điểm tham quan"
                    android:textAllCaps="false"
                    android:textColor="#B5534A"
                    android:backgroundTint="#F6EAE8"
                    android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>

        <!-- THANH HANH DONG CO DINH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="#FFFFFF"
            android:elevation="6dp">

            <Button
                android:id="@+id/dtHuy"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="#2C7351"
                android:backgroundTint="#E8F2E6"/>

            <Button
                android:id="@+id/dtLuu"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Lưu điểm tham quan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C7351"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
