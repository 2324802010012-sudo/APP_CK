<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8F5"
    android:focusableInTouchMode="true">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F6F8F5">

        <TextView
            android:id="@+id/ddFormQuayLai"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:padding="12dp"
            android:drawableStart="@drawable/ui_tq_back"
            android:drawableTint="#2C7351"
            android:background="@drawable/ui_ct_audio_bg"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quay về danh sách địa điểm"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ddFormTieuDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thêm địa điểm"
                android:textSize="19sp"
                android:textColor="#182D22"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Thông tin hiển thị trong ứng dụng"
                android:textSize="12sp"
                android:textColor="#687B6E"/>

        </LinearLayout>

    </LinearLayout>

    <!-- NOI DUNG BIEU MAU -->

    <ScrollView
        android:id="@+id/ddFormVungCuon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- NHOM 1: THONG TIN CO BAN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/ui_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thông tin cơ bản"
                    android:textSize="16sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nhập thông tin để nhận diện địa điểm"
                    android:textSize="12sp"
                    android:textColor="#687B6E"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Tên địa điểm *"/>

                <EditText
                    android:id="@+id/ddFormTen"
                    style="@style/DDInput"
                    android:hint="Ví dụ: Dinh Độc Lập"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Địa chỉ"/>

                <EditText
                    android:id="@+id/ddFormDiaChi"
                    style="@style/DDInput"
                    android:hint="Số nhà, đường, tỉnh/thành phố"
                    android:inputType="textPostalAddress"
                    android:imeOptions="actionNext"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Danh mục"/>

                <Spinner
                    android:id="@+id/ddFormDanhMuc"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/ui_ct_action_bg"
                    android:contentDescription="Chọn danh mục địa điểm"/>

            </LinearLayout>

            <!-- NHOM 2: GIOI THIEU VA VI TRI -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/ui_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giới thiệu và vị trí"
                    android:textSize="16sp"
                    android:textColor="#182D22"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nội dung giới thiệu và tọa độ GPS"
                    android:textColor="#687B6E"
                    android:textSize="12sp"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Giới thiệu địa điểm"/>

                <EditText
                    android:id="@+id/ddFormMoTa"
                    style="@style/DDInput"
                    android:layout_height="wrap_content"
                    android:minHeight="112dp"
                    android:gravity="top|start"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:hint="Giới thiệu lịch sử, nét nổi bật của địa điểm..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:singleLine="false"
                    android:minLines="4"
                    android:maxLines="8"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Tọa độ GPS *"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Vĩ độ"
                            android:textColor="#687B6E"
                            android:textSize="12sp"/>

                        <EditText
                            android:id="@+id/ddFormViDo"
                            style="@style/DDInput"
                            android:layout_width="match_parent"
                            android:hint="10.777000"
                            android:inputType="numberDecimal|numberSigned"
                            android:imeOptions="actionNext"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Kinh độ"
                            android:textColor="#687B6E"
                            android:textSize="12sp"/>

                        <EditText
                            android:id="@+id/ddFormKinhDo"
                            style="@style/DDInput"
                            android:layout_width="match_parent"
                            android:hint="106.695300"
                            android:inputType="numberDecimal|numberSigned"
                            android:imeOptions="actionDone"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:background="@drawable/ui_ct_audio_bg">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="ⓘ"
                        android:textColor="#2C7351"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Nhập tọa độ GPS dưới dạng số thập phân. Đây là vị trí thật của địa điểm, không phải tọa độ marker trên ảnh sơ đồ."
                        android:textColor="#416C55"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- NHOM 3: HINH ANH -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/ui_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hình ảnh địa điểm"
                    android:textColor="#182D22"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ảnh đại diện hiển thị trong ứng dụng"
                    android:textColor="#687B6E"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- ANH XEM TRUOC GON -->

                    <ImageView
                        android:id="@+id/ddFormAnh"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:padding="26dp"
                        android:background="@drawable/ui_ct_thumb"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:scaleType="centerInside"
                        android:clipToOutline="true"
                        android:contentDescription="Ảnh đại diện địa điểm. Chạm để chọn ảnh"
                        android:clickable="true"
                        android:focusable="true"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ddFormTrangThaiAnh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chưa chọn ảnh"
                            android:textColor="#182D22"
                            android:textSize="13sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Chọn ảnh để thay hình đại diện"
                            android:textColor="#687B6E"
                            android:textSize="12sp"/>

                        <Button
                            android:id="@+id/ddFormChonAnh"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="9dp"
                            android:text="Chọn ảnh"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="#2C7351"
                            android:backgroundTint="#E8F2E6"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- CHUC NANG NANG CAO: ANH DRAWABLE -->

                <TextView
                    android:id="@+id/ddFormMoRongAnh"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:text="Ảnh có sẵn trong dự án  ▾"
                    android:textColor="#2C7351"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:id="@+id/ddFormNangCaoAnh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:text="Tên tài nguyên drawable"
                        android:textColor="#687B6E"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/ddFormTenAnh"
                        style="@style/DDInput"
                        android:hint="Ví dụ: anh_dinh_doc_lap"
                        android:inputType="text"
                        android:singleLine="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Chỉ nhập tên ảnh có sẵn trong res/drawable, không kèm đuôi .png hoặc .jpg."
                        android:textColor="#687B6E"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- NHOM 4: NGUON THAM KHAO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/ui_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nguồn tham khảo"
                    android:textColor="#182D22"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Có thể để trống nếu chưa có nguồn"
                    android:textColor="#687B6E"
                    android:textSize="12sp"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Tên nguồn"/>

                <EditText
                    android:id="@+id/ddFormTenNguon"
                    style="@style/DDInput"
                    android:hint="Ví dụ: Website chính thức"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionNext"/>

                <TextView
                    style="@style/DDLabel"
                    android:text="Đường dẫn nguồn"/>

                <EditText
                    android:id="@+id/ddFormUrlNguon"
                    style="@style/DDInput"
                    android:hint="https://..."
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:imeOptions="actionDone"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Nguồn tham khảo được liên kết với thông tin địa điểm, không chèn trực tiếp vào lời thuyết minh."
                    android:textColor="#687B6E"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- THANH HANH DONG CO DINH -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/ddFormXoa"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:text="Xóa"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#B24B41"
            android:backgroundTint="#F6EAE8"
            android:visibility="gone"/>

        <Button
            android:id="@+id/ddFormLuu"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Lưu địa điểm"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="#2C7351"/>

    </LinearLayout>

</LinearLayout>
