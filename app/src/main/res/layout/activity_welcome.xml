<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FBFCF9">

    <ScrollView
        android:id="@+id/cuonTrangChaoMung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- BAN DO TUONG TAC GIOI THIEU DIA DIEM -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="300dp"
                android:background="@drawable/nen_dau_chao_moi"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.example.app_ck.BanDoChaoMungView
                    android:id="@+id/banDoChaoMung"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Bản đồ tương tác các địa điểm tham quan. Kéo để di chuyển, chụm hai ngón để phóng to hoặc thu nhỏ." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:padding="8dp"
                    android:background="#EEFBFCF9"
                    android:text="Khám phá các điểm đến"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#142B25" />

                <LinearLayout
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/chaoPhongToBanDo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="24sp"
                        android:textColor="#147657"
                        android:backgroundTint="#FBFCF9"
                        android:contentDescription="Phóng to bản đồ" />

                    <Button
                        android:id="@+id/chaoThuNhoBanDo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="24sp"
                        android:textColor="#147657"
                        android:backgroundTint="#FBFCF9"
                        android:contentDescription="Thu nhỏ bản đồ" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="28dp"
                    android:padding="4dp"
                    android:background="#EEFBFCF9"
                    android:text="© OpenStreetMap contributors"
                    android:textColor="#24382D"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- SONG XANH NGAN CACH BAN DO VA TIEN ICH -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="-28dp"
                android:src="@drawable/song_trang_tri"
                android:scaleType="fitXY"
                android:contentDescription="Sóng xanh trang trí" />

            <!-- BA TIEN ICH GIOI THIEU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/nen_icon_chao_moi">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ban_do_chao"
                            android:contentDescription="Bản đồ tương tác" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center"
                        android:text="Bản đồ tương tác"
                        android:textColor="#142B25"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Khám phá di tích\ntrên bản đồ"
                        android:textColor="#75817A"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/nen_icon_chao_moi">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_thuyet_minh_chao"
                            android:contentDescription="Thuyết minh giọng nói" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center"
                        android:text="Thuyết minh"
                        android:textColor="#142B25"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Nghe giới thiệu\ntại điểm đến"
                        android:textColor="#75817A"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/nen_icon_chao_moi">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lo_trinh_chao"
                            android:contentDescription="Lộ trình tham quan" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center"
                        android:text="Lộ trình tham quan"
                        android:textColor="#142B25"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Gợi ý hành trình\nphù hợp"
                        android:textColor="#75817A"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- NUT BAT DAU VA DANG NHAP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/btnBatDau"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Bắt đầu khám phá  →"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#147657" />

                <TextView
                    android:id="@+id/btnDangNhap"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Đã có tài khoản? Đăng nhập"
                    android:textColor="#246B51"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
