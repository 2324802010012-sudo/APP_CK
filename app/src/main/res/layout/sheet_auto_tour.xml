<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/ui_ct_content_bg">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ui_ct_category"
            android:backgroundTint="#BDCABD"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hướng dẫn tham quan"
            android:textSize="23sp"
            android:textColor="#182D22"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Chọn cách bạn muốn khám phá di sản."
            android:textColor="#687B6E"
            android:textSize="14sp"/>

        <!-- GPS THAT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/ui_ct_audio_bg">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ui_ic_route"
                android:background="@drawable/ui_ct_floating_circle"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Theo vị trí GPS"
                android:textColor="#182D22"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tourMoTaGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#53685A"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tourGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="Bật hướng dẫn GPS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2C7351"
                app:cornerRadius="15dp"/>

        </LinearLayout>

        <!-- CHE DO MO PHONG -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/ui_ct_action_bg">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ui_ic_map"
                android:background="@drawable/ui_ct_audio_bg"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tham quan mô phỏng"
                android:textColor="#182D22"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tourMoTaDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#53685A"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tourDemo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="Bắt đầu mô phỏng"
                android:textAllCaps="false"
                android:textColor="#2C7351"
                app:strokeColor="#C8DCC9"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="15dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Bạn luôn có thể chọn điểm và nghe thủ công."
            android:textColor="#687B6E"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
